// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      String   @default("ADMIN")
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student Student?
  teacher Teacher?
  parent  Parent?

  @@index([role])
  @@index([schoolId])
  @@map("users")
}

model Student {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  admissionNumber String
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade           String?
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  classId         String?
  class           Class?   @relation(fields: [classId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // Relations
  attendances Attendance[]
  grades      Grade[]
  parents     ParentStudent[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([classId])
  @@index([deletedAt])
  @@map("students")
}

model Teacher {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  subject     String?
  type        String   @default("CLASS_TEACHER") // CLASS_TEACHER or SUBJECT_TEACHER
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  classSubjects TeacherClassSubject[]
  attendances   Attendance[]

  @@map("teachers")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  students ParentStudent[]

  @@map("parents")
}

model ParentStudent {
  parentId String
  parent   Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@map("parent_students")
}

model School {
  id        String   @id @default(cuid())
  name      String
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users            User[]
  parents          Parent[]
  teachers         Teacher[]
  classes          Class[]
  students         Student[]
  subjects         Subject[]
  grades           Grade[]
  gradeBands       GradeBand[]
  attendances      Attendance[]
  academicSessions AcademicSession[]

  @@map("schools")
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  terms Term[]

  @@map("academic_sessions")
}

model Term {
  id        String          @id @default(cuid())
  name      String
  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id])
  isActive  Boolean         @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  // Relations
  grades Grade[]

  @@map("terms")
}

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  grade       String
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  classSubjects TeacherClassSubject[]
  subjects      ClassSubject[]
  students      Student[]
  attendances   Attendance[]
  grades        Grade[]

  @@index([schoolId])
  @@index([deletedAt])
  @@map("classes")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  classes       ClassSubject[]
  classSubjects TeacherClassSubject[]
  grades        Grade[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([deletedAt])
  @@map("subjects")
}



// Join table for Class-Subject assignment
model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// Unified join table for Teacher-Class-Subject assignments
// - CLASS_TEACHER: teacher assigned to a class (subjectId is null)
// - SUBJECT_TEACHER: teacher assigned to teach a specific subject in a class
model TeacherClassSubject {
  id             String   @id @default(cuid())
  teacherId      String
  teacher        Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId        String
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String?  // null for CLASS_TEACHER assignments
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignmentType String   @default("SUBJECT_TEACHER") // CLASS_TEACHER or SUBJECT_TEACHER
  createdAt      DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
  @@map("teacher_class_subjects")
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  date      DateTime
  status    String   @default("PRESENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([studentId, classId, date])
  @@index([classId])
  @@index([date])
  @@index([schoolId])
  @@index([studentId])
  @@map("attendances")
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  caScore   Float?
  examScore Float?
  total     Float?
  grade     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([studentId, subjectId, termId])
  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
  @@index([schoolId])
  @@map("grades")
}

model GradeBand {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level     String
  letter    String
  minScore  Float
  maxScore  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, level, letter])
  @@index([schoolId, level, minScore, maxScore])
  @@map("grade_bands")
}
